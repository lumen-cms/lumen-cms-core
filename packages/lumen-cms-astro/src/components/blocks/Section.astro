---
import type { BlockProps } from '../../lib/blockProps'
import { blockChildren } from '../../lib/blockProps'
import Block from '../Block.astro'
import Section from '../Section.astro'
import Background from '../Background.astro'
interface Props extends Omit<BlockProps, 'content'> { content: Extract<BlockProps['content'], { component: 'section' }> }
const { content, context, sectionPosition } = Astro.props
---
<Section content={content} theme={context.theme}>
 <Background slot="background" content={content.background?.[0]} backgroundStyle={content.background_style} sectionPosition={sectionPosition} />
 {blockChildren(content.body).map(item => <Block content={item} context={context} />)}
</Section>
