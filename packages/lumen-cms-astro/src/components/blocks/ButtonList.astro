---
import type { BlockProps } from '../../lib/blockProps'
import { blockChildren } from '../../lib/blockProps'
import Block from '../Block.astro'
interface Props extends Omit<BlockProps, 'content'> { content: Extract<BlockProps['content'], { component: 'button_list' }> }
const { content, context } = Astro.props
---
<div class:list={[content.class_names?.values, { 'lm-button-list__margin-left': content.property?.includes('margin_left') }]}>{blockChildren(content.body).map(child => <Block content={child} context={context} />)}</div>
