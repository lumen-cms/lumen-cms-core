---
import type { BlockProps } from '../../lib/blockProps'
import { blockChildren } from '../../lib/blockProps'
import Block from '../Block.astro'
import GridColumn from '../GridColumn.astro'
import Background from '../Background.astro'
interface Props extends Omit<BlockProps, 'content'> { content: Extract<BlockProps['content'], { component: 'column' }> }
const { content, context, direction } = Astro.props
---
<GridColumn content={content} theme={context.theme} direction={direction}>
 <Background slot="background" content={content.background?.[0]} />
 {blockChildren(content.body).map(item => <Block content={item} context={context} />)}
</GridColumn>
