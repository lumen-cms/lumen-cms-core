---
import type { BlockProps } from '../../lib/blockProps'
import { blockChildren } from '../../lib/blockProps'
import Block from '../Block.astro'
import Html from '../Html.astro'
interface Props extends Omit<BlockProps, 'content'> { content: Extract<BlockProps['content'], { component: 'html' }> }
const { content, context } = Astro.props
---
<Html content={content} theme={context.theme}>{blockChildren(content.blocks).map(item => <Block content={item} context={context} />)}</Html>
