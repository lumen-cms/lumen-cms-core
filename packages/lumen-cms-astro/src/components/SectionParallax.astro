---
import Image from './CmsImage.astro'
import type { SectionParallaxStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import type { RenderContext } from '../lib/context'
import { expandedLayerStyle } from 'lumen-cms-shared/parallax'
import Block from './Block.astro'
interface Props { content: SectionParallaxStoryblok; context: RenderContext; sectionPosition?: number }
const { content, context, sectionPosition } = Astro.props
const ratios = content.ratio?.split(',').map(value => value.trim()) || []
const layers = content.elements?.map(({ _uid, always_complete_animation, amount, speed, image, parallax_item_data, children, expanded, easing, ...props }) => {
 const animation: Record<string, unknown> = { shouldAlwaysCompleteAnimation: always_complete_animation || false, speed: amount ? Number(amount) * 10 : speed ? Number(speed) : -20, easing: easing || undefined }
 Object.entries(props).forEach(([key, value]) => { if (typeof value === 'string') animation[key] = value.split(',').map(part => Number(part.trim()) ? Number(part.trim()) : part.trim()) })
 return { _uid, image: image?.replace(/^\/\//,'https://'), children, animation, style: expandedLayerStyle({ expanded, speed: animation.speed as number, translateY: animation.translateY as (string | number)[] | undefined }), blurDataURL: parallax_item_data?.base64 }
}) || []
---
{(layers.length || content.body?.length) && <div class="lm-parallax-section" data-lm-parallax="pending" style={{ height: !content.ratio ? `${content.height || 50}vh` : undefined, overflow: content.allow_overflow ? 'visible' : undefined, '--lm-parallax-max': `${content.max_height_mobile || 250}px`, ...Object.fromEntries(ratios.map((ratio, index) => [`--lm-parallax-ratio-${index}`, ratio])) }}>
 <div class="lm-parallax-banner" style={{ overflow: content.allow_overflow ? 'visible' : 'hidden' }}>
  {layers.map(layer => <div class="lm-parallax-layer" data-parallax-layer={JSON.stringify(layer.animation)} style={layer.style}>
   {layer.image && <Image src={layer.image} autoSizes={false} blurDataURL={layer.blurDataURL} preload={sectionPosition === 0} alt={`image of ${layer.image}`} widths={[320,640,960,1280,1920]} sizes={content.height && content.ratio ? `${content.height}px` : '100vw'} loading={sectionPosition === 0 || content.disable_lazy_load ? 'eager' : 'lazy'} fetchpriority={sectionPosition === 0 ? 'high' : 'low'} style={{ width: '100%', height: 'auto' }} />}
   {layer.children?.map(child => <Block content={child} context={context} />)}
  </div>)}
  {content.body?.length && <div class:list={['lm-parallax-content', content.class_names?.values]}>{content.body.map(child => <Block content={child} context={context} />)}</div>}
 </div>
</div>}
<script>
 import { initializeParallax } from '../client/parallax'
 initializeParallax()
 document.addEventListener('astro:page-load', initializeParallax)
 document.addEventListener('lumen:content-mounted', initializeParallax)
</script>
