---
import type { RenderContext } from '../lib/context'
import CmsAnchor from './CmsAnchor.astro'
import { accessibleButtonName } from '../lib/accessibleButtonName'
import type { ButtonStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import type { CmsTheme } from 'lumen-cms-shared/theme'
import { getLinkAttrs, isValidLink, type LinkType } from '../lib/links'
import { blockStyles } from '../lib/blockStyles'
import Icon from './Icon.astro'
import Image from './CmsImage.astro'
interface Props { context?: RenderContext; content: ButtonStoryblok; theme: CmsTheme; type?: 'submit' | 'button'; disabled?: boolean }
const { content, context, theme, type = 'button', disabled } = Astro.props
const { css, className } = blockStyles(content, theme)
const attrs = isValidLink(content.link as LinkType) ? getLinkAttrs(content.link as LinkType, { openExternal: !!content.open_external }, context?.page) : {}
const authAction = process.env.LUMEN_AUTH_ENABLED === '1' && !context?.preview && ['login', 'signup', 'logout'].includes(content.on_click_function || '') ? content.on_click_function : undefined
if (authAction) {
 attrs.href = '/auth/' + authAction + (authAction === 'logout' ? '' : '?returnTo=' + encodeURIComponent(Astro.url.pathname + Astro.url.search) + '&locale=' + encodeURIComponent(context?.page.locale || 'en'))
}
const { href, target, rel, download } = attrs
const decorative = context?.decorativeButtons && !href && !content.on_click_function && type !== 'submit'
const Tag = decorative ? 'span' : href ? CmsAnchor : 'button'
const colors: Record<string, string> = { primary: 'btn-primary', secondary: 'btn-secondary', dark: 'btn-primary', light: 'btn-neutral', success: 'btn-success', info: 'btn-info', warning: 'btn-warning', error: 'btn-error' }
const props = content.properties || []
const labelled = !!content.label && content.variant !== 'fab'
const imageSizes: Record<string, number> = { xmall: 20, xsmall: 20, small: 24, large: 52, xlarge: 56 }
const imageSize = imageSizes[content.image_size || ({ dense: 'small', 'lm-button-large': 'large', 'lm-button-xlarge': 'xlarge' } as Record<string, string>)[content.size || '']] || 24
const customColor = content.custom_color?.rgba
const customBackground = content.variant === 'fab' || (!!content.label && ['raised', 'unelevated'].includes(content.variant || ''))
const muiVariant = ['raised', 'unelevated'].includes(content.variant || '') ? 'contained' : content.variant === 'outlined' ? 'outlined' : 'text'
const inheritColor = ['inherit', 'primary_text', 'secondary_text'].includes(content.color || '')
---
{css && !(Astro.locals as { cmsStylesInHead?: boolean }).cmsStylesInHead && <style is:inline set:html={css} />}
<Tag {...(Tag === CmsAnchor ? { context } : {})} href={href} target={target} rel={rel} download={download} type={href || decorative ? undefined : type} disabled={href || decorative ? undefined : disabled} aria-hidden={decorative && !content.label ? 'true' : undefined}
 data-lm-action={authAction ? undefined : content.on_click_function || undefined}
 class:list={['btn', 'lm-button', 'MuiButton-root', `MuiButton-${muiVariant}`, className, inheritColor ? 'lm-color-inherit' : colors[content.color || ''] || 'btn-neutral', content.variant === 'outlined' ? 'btn-outline lm-outlined' : !['raised', 'unelevated', 'fab'].includes(content.variant || '') ? 'btn-ghost' : undefined, content.size === 'dense' ? 'btn-sm' : content.size === 'lm-button-large' ? 'btn-lg' : undefined, content.corners, content.size, content.class_names?.values, content.font && `lm-font-${content.font}`, { 'lm-fab': content.variant === 'fab', 'lm-fab-extended': content.variant === 'fab' && !!content.label, 'lm-labelled-button': labelled, 'lm-icon-button': !content.label && !!(content.icon?.name || content.image) && content.variant !== 'fab', 'lm-grey-button': !content.color || content.color === 'light', 'lm-default-color': !content.color, 'btn-circle': content.variant === 'fab' && !content.label, 'w-100': props.includes('fullWidth'), 'lm-unelevated': props.includes('disable-shadow') || content.variant === 'unelevated' }]}
 data-custom-background={customColor && customBackground || undefined} data-custom-foreground={customColor && !customBackground || undefined} data-custom-border={customColor && content.variant === 'outlined' || undefined}
 style={{ '--lm-button-custom-color': customColor, '--lm-button-align': labelled ? content.align || undefined : undefined, '--lm-button-image-size': `${imageSize}px`, whiteSpace: props.includes('no-linebreak') ? 'nowrap' : undefined }} aria-label={decorative ? undefined : accessibleButtonName(content, href, context?.buttonLabel)}>
 {labelled ? <span class="lm-button-start MuiButton-startIcon">{content.image ? <span class="lm-button-image"><Image src={content.image} width={imageSize} height={imageSize} sizes={`${imageSize}px`} alt="" /></span> : content.icon?.name && <Icon name={content.icon.name} />}</span> : content.image ? <span class="lm-button-image"><Image src={content.image} width={imageSize} height={imageSize} sizes={`${imageSize}px`} alt="" /></span> : content.icon?.name && <Icon name={content.icon.name} />}
 {content.label}{content.trailing_icon?.name && <span class="lm-button-trailing MuiButton-endIcon"><Icon name={content.trailing_icon.name} /></span>}<slot />
</Tag>
