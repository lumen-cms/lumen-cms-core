---
import type { ListSearchAutocompleteStoryblok, ToolbarSearchStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import type { RenderContext } from '../lib/context'
import Icon from './Icon.astro'
import Button from './CmsButton.astro'
interface Props { content: ListSearchAutocompleteStoryblok | ToolbarSearchStoryblok; context: RenderContext }
const { content, context } = Astro.props
const options: Partial<ListSearchAutocompleteStoryblok> = content.component === 'list_search_autocomplete' ? content : { placeholder: content.placeholder }
const page = context.page
let prefix = page.defaultLocale !== page.locale ? page.locale : undefined
if (process.env.NEXT_PUBLIC_ROOT_DIRECTORY) prefix = process.env.NEXT_PUBLIC_ROOT_DIRECTORY
if (process.env.NEXT_PUBLIC_ENABLE_LOCALE_SUFFIX) prefix = page.locale
const config = { locales: page.locales, defaultLocale: page.defaultLocale, publicToken: process.env.NEXT_PUBLIC_STORYBLOK_PUBLISHABLE_KEY || '', prefix, additionalLocales: page.locales?.filter(locale => locale !== page.defaultLocale).join(',') || '', rootDirectory: process.env.NEXT_PUBLIC_ROOT_DIRECTORY, suppressSlugLocale: !!process.env.NEXT_PUBLIC_SUPPRESS_SLUG_LOCALE, languages: process.env.NEXT_PUBLIC_LANGUAGES?.split(',') || [] }
const label = options.label || options.placeholder || 'Search'
const id = `search-${content._uid}`
---
<div data-lm-search style={{ width: options.fullwidth ? '100%' : undefined }} data-search-breakpoint={options.mobile_breakpoint} data-search-config={JSON.stringify(config)} data-not-found={options.not_found_label}>
 {content.component === 'toolbar_search' && content.trigger?.length ? <span data-search-trigger>{content.trigger.map(button => <Button content={button} context={context} />)}</span> :
 <button type="button" data-search-trigger data-lm-search-version="command-palette-v1" data-lm-search-label={options.label || ''} data-lm-search-placeholder={options.placeholder || ''} class:list={['lm-search-opener', options.mobile_breakpoint && `lm-search-icon-below-${options.mobile_breakpoint}`]} aria-label={label} aria-haspopup="dialog" aria-controls={id} style={{ '--lm-search-width': options.fullwidth ? '100%' : '220px', height: `${Number(options.height) || (options.large ? 56 : 40)}px`, border: options.outlined ? '1px solid #0002' : '1px solid transparent', borderRadius: options.shape === 'square' ? 0 : options.shape === 'rounded' ? '20px' : '4px' }}>
  <Icon name={options.icon?.name || 'magnify'} /><span class="lm-search-label">{options.label && <span style={{ display: 'block', fontSize: options.placeholder ? '.75rem' : undefined }}>{options.label}</span>}{(options.placeholder || !options.label) && <span style={{ opacity: .7 }}>{options.placeholder || 'Search'}</span>}</span>
 </button>}
 <dialog id={id} class="lm-search-dialog" aria-labelledby={`${id}-title`} style={{ borderRadius: options.menu_border_radius || (options.menu_square ? '0' : undefined), border: options.menu_outlined ? '1px solid #0002' : undefined, boxShadow: options.menu_outlined ? 'none' : context.theme.shadows[options.menu_elevation !== undefined ? Number(options.menu_elevation) : 1] }}>
  <div class="lm-search-heading"><h2 id={`${id}-title`}>{options.label || 'Search'}</h2><button type="button" class="btn btn-ghost btn-circle" data-search-close aria-label="Close search">×</button></div>
  <div class="lm-search-body"><input class="input w-full" type="search" role="combobox" aria-label={options.label || 'Search'} aria-autocomplete="list" aria-expanded="true" aria-controls={`${id}-results`} placeholder={options.placeholder || 'Search pages and landing pages'} autocomplete="off" />
   <div class="lm-search-status" role="status" aria-live="polite"><span data-search-status>Type at least 2 characters to search.</span><button type="button" hidden data-search-retry class="btn btn-ghost">Retry</button></div>
   <ul id={`${id}-results`} role="listbox" class="lm-search-results"></ul>
  </div>
 </dialog>
</div>
<script>
 import { initializeSearch } from '../client/search'
 initializeSearch()
 document.addEventListener('astro:page-load', initializeSearch); document.addEventListener('lumen:content-mounted', initializeSearch)
</script>
