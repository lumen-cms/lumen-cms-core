---
import { StoryblokPreview } from '@storyblok/astro'
---
<StoryblokPreview liveUpdate bridgeOptions={{
 resolveLinks: 'url',
 resolveRelations: ['static_section.container', 'form_container.form', 'event.category', 'news.category', 'page.categories'],
}} />
<script>
 import { onStoryblokEditorEvent } from '@storyblok/live-preview'
 import { initializeStoryblokPreview } from '../client/storyblokPreview'
 initializeStoryblokPreview()
 // The public broker shares the SDK's Bridge. This observer paints rich text
 // and cancels stale requests immediately; the SDK owns debounce with its default delay.
 onStoryblokEditorEvent(story => {
  document.dispatchEvent(new CustomEvent('lumen:preview-input', { detail: { story } }))
 })
</script>
