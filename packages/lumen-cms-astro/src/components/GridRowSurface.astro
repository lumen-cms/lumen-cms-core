---
import type { RowStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
interface Props { content: RowStoryblok }
const { content } = Astro.props
---
<div id={content.section_identifier || undefined}
 class:list={['MuiGrid2-root', 'MuiGrid2-container', 'lm-grid__row', { 'lm-reverse-mobile': content.reverse_on_mobile, 'lm-reverse-tablet': content.reverse_on_tablet }]}
 style={{ '--lm-grid-spacing': `${Number(content.spacing || 3) * 8}px`, '--lm-row-direction': content.direction || 'row', '--lm-row-wrap': content.flex_wrap || 'wrap', alignItems: content.align_items || undefined, justifyContent: content.justify || undefined, alignContent: content.align_content || undefined }}>
 <slot name="background" /><slot />
</div>

