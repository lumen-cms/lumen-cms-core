---
import Image from './CmsImage.astro'
import type { BackgroundStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
interface Props { content?: BackgroundStoryblok; backgroundStyle?: string; sectionPosition?: number }
const { content, backgroundStyle, sectionPosition } = Astro.props
const priority = content?.priority || sectionPosition === 0
const images = [{ src: content?.image, className: content?.alternative_image ? 'landscape' : '' }, { src: content?.alternative_image, className: 'portrait' }].filter(image => image.src)
const layers = content?.background_elements?.map(item => item.component === 'background_element_gradient' ? item.value : item.component === 'background_element_color' ? item.color?.rgba : `url('${item.url}') ${item.horizontal || 'left'} ${item.vertical || 'top'}/${item.size_fixed || item.size || 'auto'} ${item.repeat || 'no-repeat'}`).filter(Boolean).join(',')
const fixed = ['fixed_cover', 'fixed_image'].includes(backgroundStyle || '')
---
{content && <>
 {images.length > 0 && <div class:list={['lm-background-images', { 'lm-background-fixed': fixed }]}>
  {images.map(({ src, className }) => <Image src={src!} fill alt={`bg image ${src}`} widths={[640, 960, 1280, 1920, 2560]} sizes="100vw" quality={Number(content.quality) || undefined}
    preload={priority} loading={priority || content.disable_lazy_loading ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined}
    class:list={['lm-background-image', className, content.hide_image_on_breakpoint && `hide__${content.hide_image_on_breakpoint}`]}
    style={{ objectFit: content.background_size === 'auto' ? 'cover' : content.background_size || 'cover', objectPosition: content.background_position || 'center' }} />)}
 </div>}
 {layers && <div class="lm-background-elements" style={{ background: layers }} />}
</>}
