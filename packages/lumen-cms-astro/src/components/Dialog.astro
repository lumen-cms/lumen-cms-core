---
import type { DialogStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import type { RenderContext } from '../lib/context'
import Block from './Block.astro'
interface Props { content: DialogStoryblok; context: RenderContext }
const { content, context } = Astro.props
const id = `dialog-${content._uid}`
---
<div data-lm-dialog-trigger={id} style="cursor:pointer">{content.trigger?.map(child => <Block content={child} context={context} />)}</div>
<template id={`${id}-template`}>
 <dialog id={id} class:list={['lm-dialog', content.fullscreen && `lm-dialog-full-${content.fullscreen}`]} data-prevent-outside={content.prevent_click_outside ? '' : undefined} data-slide-up={content.slide_up ? '' : undefined} aria-labelledby={`${id}-title`}>
  <div class="lm-dialog-title" style={{ display: content.prevent_close_button && !content.title ? 'none' : undefined }}>
   <div id={`${id}-title`} style="display:contents">
   {!content.custom_title?.length && <span>{content.title}</span>}
   {content.custom_title?.map(child => <Block content={child} context={context} />)}
   </div>
   {!content.prevent_close_button && <button type="button" class="btn btn-ghost btn-circle" data-dialog-close aria-label="Close dialog">×</button>}
  </div>
  {content.no_padding ? content.body?.map(child => <Block content={child} context={context} />) : <div class="lm-dialog-content">{content.body?.map(child => <Block content={child} context={context} />)}</div>}
 </dialog>
</template>
<script>
 import { initializeDialogs } from '../client/dialog'
 initializeDialogs()
 document.addEventListener('astro:page-load', initializeDialogs)
 document.addEventListener('lumen:content-mounted', initializeDialogs)
</script>
