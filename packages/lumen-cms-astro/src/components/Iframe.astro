---
import { youtubeVideoId } from '../lib/youtube'
import type { IframeStoryblok, IframeAdvancedStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import { getIframeSandbox } from 'lumen-cms-shared/core/components/iframe/iframeSandbox'
interface Props { content: IframeStoryblok | IframeAdvancedStoryblok }
const { content } = Astro.props
const videoId = youtubeVideoId(content.url || '')
const attributes = {
 class: content.responsive_ratio ? 'embed-responsive-item' : undefined,
 title: videoId ? 'YouTube video player' : `iframe_${content.url}`,
 sandbox: getIframeSandbox(content.url, Astro.url.origin), allow: (content.allow || []).join(' '),
 src: content.url, loading: 'lazy' as const,
 allowfullscreen: content.property?.includes('allow_fullscreen'), height: content.height || '100%', width: content.width || '100%', name: content.name || '',
 style: { border: '0', position: content.position, display: content.display || undefined, width: content.width || '100%', height: content.height || '100%' }
}
---
<div class:list={['lm-iframe', content.responsive_ratio && `embed-responsive embed-responsive-${content.responsive_ratio}`]} style={{ height: content.full_height ? '100%' : undefined }}>
 {videoId ? <>
  <button type="button" data-lm-youtube class:list={['lm-youtube-preview', attributes.class]} style={attributes.style} aria-label="Play YouTube video">
   <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
   <span aria-hidden="true">▶</span>
  </button>
  <template><iframe {...attributes} /></template>
  <noscript><a href={content.url}>Watch video on YouTube</a></noscript>
 </> : <iframe {...attributes} />}
</div>
<style>
 .lm-youtube-preview { position: relative; display: block; min-height: 150px; padding: 0; cursor: pointer; background: #111; color: white; overflow: hidden; }
 .lm-youtube-preview img { display: block; width: 100%; height: 100%; object-fit: cover; }
 .lm-youtube-preview span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: grid; place-items: center; width: 68px; height: 48px; border-radius: 12px; background: #c00; font-size: 26px; }
 .lm-youtube-preview:focus-visible { outline: 3px solid currentColor; outline-offset: -3px; }
</style>
<script>
 import { initializeYoutubeEmbeds } from '../client/youtube'
 initializeYoutubeEmbeds()
 document.addEventListener('astro:page-load', initializeYoutubeEmbeds)
 document.addEventListener('lumen:content-mounted', initializeYoutubeEmbeds)
</script>
