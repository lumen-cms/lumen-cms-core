---
import type { CardListStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import type { RenderContext } from '../lib/context'
import Block from './Block.astro'
interface Props { content: CardListStoryblok; context: RenderContext; disablePagination?: boolean }
const { content, context, disablePagination } = Astro.props
const ratios: Record<string, string> = { '1x1': '100%', '4x3': '75%', '3x2': '66.66%', '2x3': '150%', '1x3': '300%', '3x1': '33.33%', '2.85x1': '35.09%' }
---
<div class:list={['lm-card-list', content.variant?.map(variant => `card__${variant}`)]} style={{ '--lm-card-gap': `${Number(content.column_gap || 24)}px`, '--lm-card-phone': Number(content.column_count_phone || 1), '--lm-card-tablet': Number(content.column_count_tablet || content.column_count || 3), '--lm-card-desktop': Number(content.column_count || 4), '--lm-card-ratio': ratios[content.image_ratio || ''] || '56.25%' }}>
 <div class="lm-card-grid MuiGrid2-container">
  {content.body?.map((item, index) => <div class="lm-card-grid-item MuiGrid2-root" data-lm-list-item={item._uid} hidden={!disablePagination && index >= 30} data-lm-card-page={disablePagination ? undefined : Math.floor(index / 30)}><Block content={item} options={content} context={context} /></div>)}
 </div>
 {!disablePagination && (content.body?.length || 0) > 30 && <div data-lm-card-more aria-hidden="true" style="height:1px" />}
</div>
<script>
 import { initializeCardLists } from '../client/cardList'
 initializeCardLists()
 document.addEventListener('astro:page-load', initializeCardLists)
 document.addEventListener('lumen:content-mounted', initializeCardLists)
</script>
