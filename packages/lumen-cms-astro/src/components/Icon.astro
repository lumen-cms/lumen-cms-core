---
import { iconSvg } from '../lib/icons'
interface Props { name?: string; url?: string; size?: string | number; class?: string }
const { name, url, size, class: className } = Astro.props
const svg = await iconSvg(name, url).catch(() => { console.warn(`Icon could not be loaded: ${name || 'custom icon'}`); return '' })
---
{svg && <span class:list={['lm-svg-icon', className]} aria-hidden="true" style={{ fontSize: size ? `${size}px` : undefined }} set:html={svg} />}
