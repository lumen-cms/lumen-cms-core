---
import { staticRoutes, loadPage } from '../server/pages'
import SiteLayout from '../layouts/SiteLayout.astro'
export async function getStaticPaths() {
  return process.env.LUMEN_SITE ? staticRoutes() : []
}
const page = await loadPage(Astro.params.slug, Astro.props)
---
<SiteLayout page={page} />
