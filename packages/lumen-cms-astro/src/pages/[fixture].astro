---
import '../styles/global.css'
import AuslandszeitList from '../travel/AuslandszeitList.astro'
import type { AuslandszeitData } from 'lumen-cms-shared/core/travel/components/auslandszeit/auslandszeitTypes'
import TravelDetail from '../travel/Travel.astro'
import TravelList from '../travel/TravelList.astro'
import TravelSearchBox from '../travel/TravelSearchBox.astro'
import type { Travel, AllTravelsQuery } from 'lumen-cms-shared/core/travel/typings/generated/hasura-schema'
import type { ISbStoryData } from 'storyblok-js-client'
import type { RichTextEditorStoryblok, FormBuilderStoryblok } from 'lumen-cms-shared/core/typings/generated/components-schema'
import OverrideListLayout from '../components/fixtures/OverrideListLayout.astro'
import OverrideNavItem from '../components/fixtures/OverrideNavItem.astro'
import OverrideHeadline from '../components/fixtures/OverrideHeadline.astro'
import CmsHeadline from '../components/CmsHeadline.astro'
import CmsButton from '../components/CmsButton.astro'
import OverrideButton from '../components/fixtures/OverrideButton.astro'
import OverrideField from '../components/fixtures/OverrideField.astro'
import OverrideCollectionItem from '../components/fixtures/OverrideCollectionItem.astro'
import OverrideImageListItem from '../components/fixtures/OverrideImageListItem.astro'
import OverrideFormBuilder from '../components/fixtures/OverrideFormBuilder.astro'
import OverrideLink from '../components/fixtures/OverrideLink.astro'
import RichText from '../components/RichText.astro'
import { renderRichText } from '../lib/richText'
import AppWrappers from '../components/AppWrappers.astro'
import OuterWrapper from '../components/fixtures/OuterWrapper.astro'
import InnerWrapper from '../components/fixtures/InnerWrapper.astro'
import Header from '../components/Header.astro'
import Button from '../components/Button.astro'
import CustomScripts from '../components/CustomScripts.astro'
import FastSpringProvider from '../components/FastSpringProvider.astro'
import ShopifyProductDescription from '../components/ShopifyProductDescription.astro'
import ShopifyCart from '../components/ShopifyCart.astro'
import EventCalendar from '../components/EventCalendar.astro'
import Drawers from '../components/Drawers.astro'
import StoryListResults from '../components/StoryListResults.astro'
import ListStories from '../components/ListStories.astro'
import type { LmListStoriesProps } from 'lumen-cms-shared/core/components/list-widget/listWidgetTypes'
import type { ListStoriesData } from 'lumen-cms-shared/core/components/list-widget/listWidgetTypes'
import type { LmListWidgetProps, LmCategoryBoxProps } from 'lumen-cms-shared/core/components/list-widget/listWidgetTypes'
import type { RenderContext } from '../lib/context'
import GoogleForm from '../components/GoogleForm.astro'
import Block from '../components/Block.astro'
import Headline from '../components/Headline.astro'
import FlexRow from '../components/FlexRow.astro'
import Html from '../components/Html.astro'
import Section from '../components/Section.astro'
import GridRow from '../components/GridRow.astro'
import GridColumn from '../components/GridColumn.astro'
import { createCmsTheme, themeCss } from 'lumen-cms-shared/theme'
export function getStaticPaths() { return process.env.LUMEN_SITE ? [] : ['__fixture', '__story_list', '__navigation', '__header', '__tabs', '__story_links', '__story_props', '__travel_en', '__travel_de', '__jobs'].map(fixture => ({ params: { fixture } })) }
const richTextFixture = { type: 'doc', content: [
 { type: 'heading', attrs: { level: 2 }, content: [{ type: 'text', text: 'Rich heading' }] },
 { type: 'paragraph', content: [{ type: 'text', text: '<Safe> & linked', marks: [{ type: 'link', attrs: { href: 'de/home?source=rich#section', linktype: 'story', target: '_blank' } }, { type: 'bold' }, { type: 'italic' }] }, { type: 'hard_break' }, { type: 'text', text: 'styled', marks: [{ type: 'styled', attrs: { class: 'fixture-style' } }, { type: 'underline' }, { type: 'strike' }] }] },
 { type: 'blockquote', content: [{ type: 'paragraph', content: [{ type: 'text', text: 'Quoted', marks: [{ type: 'strong' }] }] }] },
 { type: 'ordered_list', content: [{ type: 'list_item', content: [{ type: 'paragraph', content: [{ type: 'text', text: 'Ordered' }] }] }] },
 { type: 'bullet_list', content: [{ type: 'list_item', content: [{ type: 'text', text: 'Bullet', marks: [{ type: 'code' }] }] }] },
 { type: 'code_block', attrs: { class: 'language-js' }, content: [{ type: 'text', text: 'a < b && c' }] },
 { type: 'horizontal_rule' }, { type: 'paragraph', content: [] },
 { type: 'image', attrs: { src: '/fixture-image.png', alt: 'A "quote"', width: 12, height: 10, onclick: 'unsafe()' } },
 { type: 'unknown', content: [{ type: 'text', text: 'Unknown preserved', marks: [{ type: 'unknown' }] }] },
 { type: 'blok', attrs: { body: [] } }
] }
const referencedForm = { content: { component: 'form_builder', _uid: 'referenced-builder', additional_fields: [{ component: 'form_hidden_field', _uid: 'default-extra', name: 'source', value: 'default' }], success_message: [{ component: 'headline', _uid: 'default-success', text: 'Default success' }] } } as ISbStoryData<FormBuilderStoryblok>
const theme = createCmsTheme()
const calendarStart = new Date(); calendarStart.setHours(10, 0, 0, 0)
const calendarEnd = new Date(calendarStart); calendarEnd.setHours(11)
const calendarCmsDate = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')} ${String(date.getHours()).padStart(2, '0')}:00`
const shopifyFixtureContext: RenderContext = { theme, preview: false, page: {
 settings: { component: 'global', theme_base: 'base', _uid: 'shopify-settings', ecommerce: [{ component: 'ecommerce_shopify_config', _uid: 'shopify-config', currency_prefix: '€', domain: 'fixture.myshopify.com', access_token: 'public-fixture-token', columns_first_width: '4', columns_second_width: '8', image_container_height: '240', product_title: [{ component: 'headline', _uid: 'product-title', typography: 'headline3', text: 'This must be replaced' }], product_variant: [{ component: 'button', _uid: 'variant-inactive', color: 'secondary' }], product_active_variant: [{ component: 'button', _uid: 'variant-active', color: 'primary' }] }] },
 allShopifyProducts: [{ node: { id: 'fixture-product', handle: 'fixture-product', title: 'Native Shopify product', descriptionHtml: '<p>Product description from Shopify</p>', variants: { edges: ['Small', 'Large'].map((title, index) => ({ node: { id: `fixture-variant-${index}`, title, priceV2: { amount: index ? '20.00' : '10.00', currencyCode: 'EUR' }, compareAtPriceV2: index ? null : { amount: '15.00', currencyCode: 'EUR' }, selectedOptions: [{ name: 'Size', value: title }], image: { transformedSrc: 'https://a.storyblok.com/f/123/800x400/fixture.jpg' } } })) } } }] as unknown as NonNullable<RenderContext['page']['allShopifyProducts']>
} }
const travelFixture = { id: 42, title: 'Native travel fixture', city: { title: 'City', title_de: 'Stadt', country: { title: 'Country', title_de: 'Land' } }, mn_travel_travel_types: [{ travel_type: { title: 'Internship', title_de: 'Praktikum' } }], product: { product_price: { eur: 1200, usd: 1500 } }, fileStoryblokByHeaderImageId: { url_new: 'https://a.storyblok.com/f/123/800x400/fixture.jpg' }, file_storybloks: Array.from({ length: 8 }, (_, index) => ({ id: index + 1, url_new: `https://a.storyblok.com/f/123/800x500/gallery-${index}.jpg` })), overview: '<p>Travel overview fixture</p>', description: '<p>Travel description fixture</p>', travel_accommodation: { description: '<p>Travel accommodation fixture</p>' }, travel_service: { description: '<p>Travel services fixture</p>' }, travel_team: { description: '<p>Travel team fixture</p>', file_storyblok: { url_new: 'https://a.storyblok.com/f/123/800x400/fixture.jpg' } } } as unknown as Travel
const newsItems = [{ uuid: 'fixture-news', full_slug: 'fixture-news', name: 'News fallback', content: { component: 'news', title: 'Native news title', description: 'Native news description' } }] as ListStoriesData[]
const storyListFixture = { component: 'list_stories', _uid: 'paginated-fixture', layout: [{ component: 'card_list', _uid: 'story-cards', description_max_character: '8' }], pagination: [{ component: 'pagination', _uid: 'story-pagination', items_per_page: '2', position: 'top_bottom' }], list_stories_data: { data: { stories: newsItems }, perPage: 2, total: 6 }, not_found_message: [{ component: 'headline', _uid: 'story-empty', text: 'No matching stories' }] } as LmListStoriesProps['content']
const navContext: RenderContext = { theme, preview: false, page: { locale: 'en', defaultLocale: 'en', settings: { component: 'global', theme_base: 'base', _uid: 'settings', website_title: 'Fixture navigation', multi_toolbar: [{ component: 'toolbar_row', _uid: 'toolbar', body: [{ component: 'toolbar_row_section', _uid: 'brand', body: [{ component: 'toolbar_logo', _uid: 'logo' }] }, { component: 'toolbar_row_section', _uid: 'links', use_media_query: true, body: [{ component: 'nav_menu', _uid: 'nav-menu', title: 'Explore fixture', body: [{ component: 'nav_menu_item', _uid: 'menu-a', label: 'Menu A', link: { fieldtype: 'multilink', linktype: 'url', url: '#a', cached_url: '#a', id: '' } }, { component: 'nav_menu_item', _uid: 'menu-b', label: 'Menu B', link: { fieldtype: 'multilink', linktype: 'url', url: '#b', cached_url: '#b', id: '' } }] }] }, { component: 'toolbar_row_section', _uid: 'mobile', inv_use_media_query: true, body: [{ component: 'toolbar_navi_button', _uid: 'toggle' }] }] }] } } }

const headerContext = (variant: 'dark' | 'white' | 'primary', feature = false): RenderContext => ({ ...navContext, page: { ...navContext.page, page: { component: 'page', _uid: `header-${variant}`, property: feature ? ['has_feature'] : [] }, settings: { ...navContext.page.settings!, toolbar_variant: variant, toolbar_elevation: '0', toolbar_font_size: '19px', toolbar_config: ['text_bold'], multi_toolbar: [{ component: 'toolbar_row', _uid: 'header-row', body: [{ component: 'toolbar_row_section', _uid: 'header-section', body: [{ component: 'button', _uid: 'header-button', label: 'Header button' }, { component: 'toolbar_navi_button', _uid: 'header-toggle', force_show: true }, { component: 'list_search_autocomplete', _uid: `header-search-${variant}`, placeholder: 'Header search' }] }] }] } } })

// The fixture omits delivery metadata unused by these presentational components.
const filterWidget = { component: 'list_widget', _uid: 'filter-widget', enable_for_search: true, list_options: [{ component: 'lists', _uid: 'filter-options', hide_image: true }], list_widget_data: { items: [{ uuid: 'one', name: 'Alpha', full_slug: 'alpha', tag_list: ['tag-a'], content: { component: 'page', preview_title: 'Alpha' } }, { uuid: 'two', name: 'Beta', full_slug: 'beta', tag_list: ['tag-b'], content: { component: 'page', preview_title: 'Beta' } }] }, not_found_content: [{ component: 'headline', _uid: 'empty', text: 'No fixture matches' }] } as unknown as LmListWidgetProps['content']
const categoryFixture = { component: 'category_box', _uid: 'category-fixture', category_box_data: [{ uuid: 'category-a', name: 'Category A', content: { component: 'category', name: 'Category A', tag_reference: { values: 'tag-a' } } }, { uuid: 'category-b', name: 'Category B', content: { component: 'category', name: 'Category B', tag_reference: { values: 'tag-b' } } }] } as unknown as LmCategoryBoxProps['content']

---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Lumen Astro migration fixtures</title><style is:inline set:html={themeCss(theme)} /><style is:inline>@layer components { .fixture-layer-sentinel { display: block; } }</style>{Astro.params.fixture === '__fixture' && <CustomScripts scripts={[
    { component: 'script', _uid: 'cms-before', strategy: 'beforeInteractive', script_body: 'window.cmsScriptFixture = ["before"];' },
    { component: 'script', _uid: 'cms-interactive', attributes: 'nonce=fixture-nonce,data-mode=fixture', script_body: 'window.cmsScriptFixture.push("interactive");' },
    { component: 'script', _uid: 'cms-external', url: '/cms-fixture.js' },
    { component: 'script', _uid: 'cms-external-duplicate', url: '/cms-fixture.js' },
    { component: 'script', _uid: 'cms-lazy', strategy: 'lazyOnload', script_body: 'window.cmsScriptFixture.push("lazy");' }
  ]} />}</head>
  <body><Header context={navContext} /><main>
    <div id="iframe-sizing-fixture" style="width:240px">
      {(['16by9', '4by3', '3by2', '1by1'] as const).map(ratio => <Block context={navContext} content={{ component: 'iframe', _uid: `iframe-${ratio}`, url: 'about:blank', responsive_ratio: ratio }} />)}
      <Block context={navContext} content={{ component: 'iframe', _uid: 'iframe-position', url: 'about:blank', responsive_ratio: '16by9', position: 'relative', width: '120px', height: '80px', name: 'position-override', property: ['allow_fullscreen'], allow: ['encrypted-media'] }} />
      <div style="height:100px"><Block context={navContext} content={{ component: 'iframe', _uid: 'iframe-full', url: 'about:blank', full_height: true }} /></div>
    </div>
    <div id="display-utilities-fixture"><div data-display="phone" class="d-sm-none">Phone</div><div data-display="tablet" class="d-none d-sm-block d-md-none">Tablet</div><div data-display="desktop" class="d-none d-md-block">Desktop</div></div>
    <div id="grid-image-spacing-fixture"><Block context={navContext} content={{ component: 'row', _uid: 'image-row', body: [1,2,3].map((item) => ({ component: 'column', _uid: `image-col-${item}`, width_general: '4', width_tablet: '3', width_phone: '4', align_items: 'center', body: [{ component: 'image', _uid: `image-${item}`, source: 'https://a.storyblok.com/f/123/800x400/fixture.jpg', width: '40', height: '40' }, { component: 'headline', _uid: `image-heading-${item}`, text: 'Aligned heading' }, { component: 'html', _uid: `image-body-${item}`, body: `<div style="height:${item * 50}px">Variable height</div>` }] })) }} /></div>

    {Astro.params.fixture === '__header' && <div id="header-appearance-fixture">
      <div id="header-dark"><Header context={headerContext('dark')} /></div>
      <div id="header-white"><Header context={headerContext('white')} /></div>
      <div id="header-feature"><Header context={headerContext('primary', true)} /></div>
    </div>}

    <Headline content={{ component: 'headline', _uid: 'heading', text: 'Lumen Astro migration', typography: 'headline1' }} theme={theme} />
    <FlexRow content={{ component: 'flex_row', _uid: 'flex', gap: '2', column_mobile_only: true }} theme={theme}>
      <button class="btn btn-primary">Primary button</button><button class="btn btn-secondary">Secondary button</button>
    </FlexRow>
    {Astro.params.fixture === '__tabs' && <div id="tabs-sizing-fixture" style="text-align:center">
      <Block context={navContext} content={{ component: 'tabs', _uid: 'grow-tabs', vertical_tabs: true, tabs_width: '3', content_width: 'true', body: [{ component: 'tabs_item', _uid: 'grow-tab', title: 'Flexible tab', body: [{ component: 'headline', _uid: 'grow-panel', text: 'Flexible content' }] }] }} />
      <Block context={navContext} content={{ component: 'tabs', _uid: 'scroll-tabs', centered: true, mobile_breakpoint: 'md', variant: 'scrollable', body: Array.from({ length: 12 }, (_, i) => ({ component: 'tabs_item' as const, _uid: `scroll-tab-${i}`, title: `Long tab title ${i}`, body: [] })) }} />
      <Block context={navContext} content={{ component: 'tabs', _uid: 'fixed-list-tabs', vertical_tabs: true, tabs_width: '3', content_width: '9', body: [{ component: 'tabs_item', _uid: 'grow-list-tab', title: 'Fixed tab list', body: [{ component: 'headline', _uid: 'grow-list-panel', text: 'Left aligned panel' }] }] }} />
    </div>}
    <div id="renderer-override-fixture">
      <AppWrappers context={navContext} wrappers={[OuterWrapper, InnerWrapper]}><span id="wrapped-content">Wrapped content</span></AppWrappers>
      <AppWrappers context={navContext}><span id="unwrapped-content">Unwrapped content</span></AppWrappers>
      <Block context={{ ...navContext, components: { headline: OverrideHeadline } }} content={{ component: 'section', _uid: 'override-section', body: [{ component: 'headline', _uid: 'overridden-heading', text: 'Nested overridden heading' }] }} />
      <Block context={navContext} content={{ component: 'headline', _uid: 'default-heading', text: 'Default heading remains' }} />
    </div>
    <div id="nested-renderer-override-fixture" hidden>
      <Block context={{ ...navContext, components: { headline: OverrideHeadline } }} content={{ component: 'nav_list', _uid: 'override-nav', header: 'Navigation slot wins', headline_styles: [{ component: 'headline', _uid: 'override-nav-style', text: 'Style fallback must not replace the slot' }] }} />
      <Block context={{ ...navContext, components: { headline: OverrideHeadline } }} content={{ component: 'card_list_item', _uid: 'override-card', title: 'Overridden card title', description: 'Overridden card description' }} />
      <CmsHeadline context={{ ...navContext, components: { headline: OverrideHeadline } }} content={{ component: 'headline', _uid: 'override-counter', count_end: '10', text: 'Overridden counter' }} />
      <CmsHeadline context={navContext} content={{ component: 'headline', _uid: 'plain-slot', text: 'Unused fallback' }}><strong>Default slot remains</strong></CmsHeadline>
    </div>
    <div id="nested-button-override-fixture" hidden>
      <CmsButton context={{ ...navContext, components: { button: OverrideButton } }} content={{ component: 'button', _uid: 'override-disabled', label: 'Disabled submit' }} type="submit" disabled><span data-override-slot>Extra content</span></CmsButton>
      <Block context={{ ...navContext, components: { button: OverrideButton, form_textfield: OverrideField } }} content={{ component: 'form_builder', _uid: 'override-form', variant: 'outlined', fields: [{ component: 'form_textfield', _uid: 'override-field', name: 'custom', label: 'Custom field', required: true }], submit: [{ component: 'button', _uid: 'override-submit', label: 'Custom submit' }] }} />
    </div>
    <div id="link-renderer-override-fixture" hidden>
      <Block context={{ ...navContext, linkRenderer: OverrideLink }} content={{ component: 'button', _uid: 'custom-linked-button', label: 'Custom linked button', open_external: true, link: { fieldtype: 'multilink', linktype: 'url', url: 'https://example.test/custom', cached_url: 'https://example.test/custom', id: '' } }} />
      <Block context={{ ...navContext, linkRenderer: OverrideLink }} content={{ component: 'nav_item', _uid: 'custom-nav', name: 'Custom navigation link', link: { fieldtype: 'multilink', linktype: 'story', url: '', cached_url: 'home', id: 'home' } }} />
      <Block context={{ ...navContext, linkRenderer: OverrideLink }} content={{ component: 'link', _uid: 'custom-content-link', link: { fieldtype: 'multilink', linktype: 'url', url: '#anchor-target', cached_url: '#anchor-target', id: '' }, body: [{ component: 'headline', _uid: 'custom-link-content', text: 'Linked content slot' }] }} />
      <Block context={navContext} content={{ component: 'button', _uid: 'default-link-button', label: 'Default link renderer', link: { fieldtype: 'multilink', linktype: 'url', url: '#default-target', cached_url: '#default-target', id: '' } }} />
    </div>
    <div id="rich-text-renderer-fixture" hidden>
      <div data-rich-reference set:html={renderRichText(richTextFixture)} />
      <div data-rich-native><RichText body={richTextFixture} context={navContext} /></div>
      <div data-rich-override><RichText body={richTextFixture} context={{ ...navContext, linkRenderer: OverrideLink }} /></div>
    </div>
    <div id="section-background-fixture" hidden>
      <Section theme={theme} content={{ component: 'section', _uid: 'preset-only', presetVariant: 'dark', background: [{ component: 'background', _uid: 'preset-shadow', shadow_effect: 'soft' }] }}>Preset background</Section>
      <Section theme={theme} content={{ component: 'section', _uid: 'explicit-variant', presetVariant: 'dark', variant: 'light' }}>Explicit background</Section>
      <Block context={navContext} content={{ component: 'slider', _uid: 'preset-slider', section_variant: 'primary', body: [{ component: 'section', _uid: 'slider-preset-section' }] }} />
      <Block context={navContext} content={{ component: 'row', _uid: 'shadow-only-row', background: [{ component: 'background', _uid: 'row-shadow', shadow_effect: 'soft' }], body: [{ component: 'column', _uid: 'shadow-only-column', background: [{ component: 'background', _uid: 'column-shadow', shadow_effect: 'float' }] }] }} />
    </div>
    <div id="card-background-fixture" hidden>
      <div id="card-description-limits">
        {[0, '0', -1, '3', undefined].map((limit, index) => <div data-limit-case={index}><Block context={navContext} options={{ component: 'card_list', _uid: `limit-options-${index}`, description_max_character: limit, column_count_phone: '2', column_count_tablet: '3', column_count: '4' }} content={{ component: 'card_list_item', _uid: `limit-card-${index}`, description: 'ABCDE', image: index === 4 ? 'https://a.storyblok.com/f/123/800x400/fixture.jpg' : undefined }} /></div>)}
      </div>
      <Block context={navContext} content={{ component: 'card', _uid: 'card-background-effect', background: [{ component: 'background', _uid: 'card-soft', shadow_effect: 'soft' }] }} />
      <Block context={navContext} content={{ component: 'card', _uid: 'card-background-precedence', square: true, elevation: '8', background: [{ component: 'background', _uid: 'card-elevation', elevation: '0', border_radius: '13px', shadow_effect: 'soft' }] }} />
    </div>
    <div id="paragraph-color-fixture" hidden>
      {([{ color: 'textSecondary' }, { color: 'primary.main' }, { color: 'textSecondary', styles: [{ component: 'styles' as const, _uid: 'paragraph-color-style', color: { rgba: 'rgb(12, 34, 56)' } }] }, { color: 'textSecondary', custom_color: { rgba: 'rgb(65, 43, 21)' } }, { color: 'textSecondary', custom_color: { rgba: 'rgb(65, 43, 21)' }, styles: [{ component: 'styles' as const, _uid: 'paragraph-custom-style', color: { rgba: 'rgb(12, 34, 56)' } }] }] satisfies Partial<RichTextEditorStoryblok>[]).map((props, index) => <Block context={navContext} content={{ component: 'rich_text_editor', _uid: `paragraph-color-${index}`, body: { type: 'doc', content: [{ type: 'paragraph', content: [{ type: 'text', text: 'Colored paragraph' }] }] }, ...props }} />)}
    </div>
    <div id="image-svg-props-fixture" hidden>
      <Block context={navContext} content={{ component: 'image', _uid: 'svg-image-props', source: 'data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20d=%22M0%200h24v24H0z%22/%3E%3C/svg%3E#fixture.svg', alt: 'Accessible SVG image', width: '40', height: '40', color: { rgba: 'rgb(20, 40, 60)' }, property: ['rounded-circle'], class_names: { values: ['cms-svg-class'] } }} />
    </div>
    <div id="card-asset-link-fixture" hidden>
      {[navContext, { ...navContext, linkRenderer: OverrideLink }].map((context, index) => <>
        <Block context={context} content={{ component: 'card', _uid: `asset-card-${index}`, link: { fieldtype: 'multilink', id: '', url: 'https://example.test/brochure.pdf', cached_url: 'https://example.test/brochure.pdf', linktype: 'asset' }, body: [{ component: 'headline', _uid: `asset-card-label-${index}`, text: 'Download brochure' }] }} />
        <Block context={context} content={{ component: 'card_list_item', _uid: `asset-list-card-${index}`, title: 'Download brochure', link: { fieldtype: 'multilink', id: '', url: 'https://example.test/brochure.pdf', cached_url: 'https://example.test/brochure.pdf', linktype: 'asset' } }} />
      </>)}
      <Block context={navContext} content={{ component: 'card_list_item', _uid: 'asset-drawer-card', title: 'Open details', link: { fieldtype: 'multilink', id: '', url: 'https://example.test/brochure.pdf', cached_url: 'https://example.test/brochure.pdf', linktype: 'asset' }, body: [{ component: 'headline', _uid: 'asset-drawer-body', text: 'Drawer content' }] }} />
    </div>
    <div id="card-action-spacing-fixture" hidden>
      {[false, true].map(linked => <Block context={navContext} content={{ component: 'card_list_item', _uid: `action-spacing-${linked}`, title: 'Card title', description: 'Card description', ...(linked ? { link: { fieldtype: 'multilink', id: '', cached_url: 'https://example.test', linktype: 'url', url: 'https://example.test' } } : {}) }} />)}
    </div>
