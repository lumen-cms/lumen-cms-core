---
import type { RenderContext } from '../lib/context'
import translations from 'lumen-cms-shared/core/travel/utils/translations'
interface Props { context: RenderContext }
const { context } = Astro.props
const language = context.page.locale?.toLowerCase() === 'de' ? 'DE' : 'EN'
const labels = translations[language]
const selects = [{ name: 'travelType', key: 'travel_type', label: labels.travel_type }, { name: 'branch', key: 'branch', label: labels.branch }, { name: 'country', key: 'country', label: labels.travelCountry }, { name: 'city', key: 'city', label: labels.city }]
---
<div data-lm-travel-search data-language={language} data-locale={context.page.locale || 'en'}>
 <label class="lm-travel-search-field"><span>{labels.search}</span><input class="input w-full" type="search" name="searchtext" autocomplete="off" /></label>
 {selects.map(field => <div class="lm-travel-search-field">
  <span>{field.label}</span>
  <div class="lm-travel-select-row">
   <details data-taxonomy={field.name} data-option-key={field.key}>
    <summary class="select w-full" aria-label={field.label}><span data-selection-label>{language === 'DE' ? 'Wählen…' : 'Choose…'}</span></summary>
    <div class="lm-travel-options" role="group" aria-label={field.label}></div>
   </details>
   <button type="button" class="lm-travel-clear" data-clear={field.name} aria-label={`${field.label}: ${language === 'DE' ? 'Alle abwählen' : 'Clear all'}`} title={language === 'DE' ? 'Alle abwählen' : 'Clear all'} hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>
 </div>)}
 <div role="status" data-travel-search-status></div><button type="button" class="btn btn-ghost" data-travel-search-retry hidden>{language === 'DE' ? 'Erneut versuchen' : 'Retry'}</button>
</div>
<style>
 .lm-travel-search-field { display: flex; flex-direction: column; gap: 4px; margin: 16px 0 8px; width: 100%; min-width: 0; }
 .lm-travel-select-row { position: relative; display: flex; align-items: center; min-width: 0; width: 100%; }
 details { position: relative; flex: 1; min-width: 0; }
 summary { cursor: pointer; display: flex; align-items: center; width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
 .lm-travel-select-row:has([data-clear]:not([hidden])) summary { padding-right: 64px; }
 .lm-travel-clear { position: absolute; right: 28px; top: 50%; transform: translateY(-50%); z-index: 1; display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: inherit; opacity: .6; cursor: pointer; transition: background-color .15s, opacity .15s; }
 .lm-travel-clear:hover { background: #8882; opacity: 1; }
 .lm-travel-clear:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; opacity: 1; }
 summary span { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .lm-travel-options { position: absolute; z-index: 20; top: calc(100% + 4px); left: 0; width: 100%; max-width: 100%; box-sizing: border-box; max-height: 300px; overflow: auto; background: var(--color-base-100, white); color: var(--color-base-content, #222); border: 1px solid #ccc; border-radius: 8px; box-shadow: 0 4px 16px #0002; padding: 6px; }
 .lm-travel-options :global(label) { display: flex; align-items: center; gap: 10px; padding: 8px; cursor: pointer; }
 .lm-travel-options :global(label > span) { min-width: 0; overflow-wrap: anywhere; }
 .lm-travel-options :global(label:hover) { background: #8882; }
 .lm-travel-options :global([data-option-count]) { opacity: .6; }
 .lm-travel-options :global([data-empty-options]) { padding: 8px; margin: 0; }
 .lm-travel-options :global([hidden]) { display: none !important; }
 .lm-travel-options :global(input) { width: 18px; height: 18px; flex-shrink: 0; }
 [hidden] { display: none !important; }
</style>
<script>
 import type { OptionItem } from 'lumen-cms-shared/core/travel/components/travel-list/travelListTypes'
 import { travelFacetCounts, type TravelTaxonomy } from 'lumen-cms-shared/travelFacets'
 import type { AllTravelsQuery } from 'lumen-cms-shared/core/travel/typings/generated/hasura-schema'
 import { getTravelState, updateTravelState } from './state'
 import { onUnmount } from '../client/lifecycle'
 function initializeTravelSearch() {
  document.querySelectorAll<HTMLElement>('[data-lm-travel-search]').forEach(root => {
   if (root.dataset.initialized) return
   root.dataset.initialized = 'true'
   const german = root.dataset.language === 'DE'
   const input = root.querySelector<HTMLInputElement>('input[type="search"]')!
   const fields = [...root.querySelectorAll<HTMLDetailsElement>('details')]
   const status = root.querySelector<HTMLElement>('[data-travel-search-status]')!
   const retry = root.querySelector<HTMLButtonElement>('[data-travel-search-retry]')!
   let timer: ReturnType<typeof setTimeout>
   const request = new AbortController()
   const list = document.querySelector<HTMLElement>('[data-travel-search-results]') || document.querySelector<HTMLElement>('[data-lm-travel-list]')
   const travels = list ? JSON.parse(list.dataset.travels || '[]') as AllTravelsQuery['travel'] : undefined
   const selected = (name: string) => String((getTravelState() as Record<string, unknown>)[name] || '').split(',').filter(Boolean)
   const sync = () => {
    for (const field of fields) {
     const values = selected(field.dataset.taxonomy!)
     const selectedValues = new Set(values)
     const checks = [...field.querySelectorAll<HTMLInputElement>('input')]
     const counts = travels ? travelFacetCounts(travels, getTravelState(), field.dataset.taxonomy as TravelTaxonomy) : undefined
     checks.forEach(check => {
      check.checked = selectedValues.has(check.value)
      const count = counts?.get(check.value) || 0
      const label = check.closest('label')!
      label.hidden = !!counts && !count && !check.checked
      label.querySelector('[data-option-count]')!.textContent = counts ? ` (${count})` : ''
     })
     const empty = field.querySelector<HTMLElement>('[data-empty-options]')
     if (empty) empty.hidden = checks.some(check => !check.closest('label')!.hidden)
     const titles = new Map(checks.map(check => [check.value, check.dataset.title]))
     const names = values.map(value => titles.get(value) || value)
     field.querySelector<HTMLElement>('[data-selection-label]')!.textContent = names.length > 2 ? `${names.length} ${german ? 'ausgewählt' : 'selected'}` : names.join(', ') || (german ? 'Wählen…' : 'Choose…')
     root.querySelector<HTMLButtonElement>(`[data-clear="${field.dataset.taxonomy}"]`)!.hidden = !values.length
    }
   }
   const load = async () => {
    retry.hidden = true; status.textContent = ''
    try {
     // Load labels once; all dependent options and counts are computed locally.
     const response = await fetch(`/api/categories?locale=${encodeURIComponent(root.dataset.locale || 'en')}`, { signal: request.signal })
     if (!response.ok) throw new Error('Category request failed')
     const data = await response.json() as Record<string, OptionItem[]>
     for (const field of fields) {
      const options = field.querySelector<HTMLElement>('.lm-travel-options')!
      options.replaceChildren()
      for (const option of data[field.dataset.optionKey!] || []) {
       const label = document.createElement('label')
       const check = document.createElement('input')
       check.type = 'checkbox'; check.value = String(option.id)
       check.dataset.title = option[german ? 'title_de' : 'title'] || String(option.id)
       const count = document.createElement('span')
       count.dataset.optionCount = ''
       const title = document.createElement('span')
       title.append(document.createTextNode(check.dataset.title), count)
       label.append(check, title)
       options.append(label)
      }
      const empty = document.createElement('p')
      empty.dataset.emptyOptions = ''
      empty.textContent = german ? 'Keine passenden Optionen' : 'No matching options'
      empty.hidden = true
      options.append(empty)
     }
     sync()
    } catch {
     if (request.signal.aborted) return
     status.textContent = german ? 'Filter konnten nicht geladen werden.' : 'Filters could not be loaded.'
     retry.hidden = false
    }
   }
   input.value = getTravelState().searchtext || ''
   input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(() => updateTravelState({ searchtext: input.value }), 750) })
   fields.forEach(field => {
    field.addEventListener('change', () => updateTravelState({ [field.dataset.taxonomy!]: [...field.querySelectorAll<HTMLInputElement>('input:checked')].map(check => check.value).join(',') }))
    field.addEventListener('toggle', () => { if (field.open) fields.forEach(other => { if (other !== field) other.open = false }) })
    field.addEventListener('keydown', event => { if (event.key === 'Escape') { field.open = false; field.querySelector('summary')!.focus() } })
   })
   const outside = (event: MouseEvent) => fields.forEach(field => { if (!field.contains(event.target as Node)) field.open = false })
   document.addEventListener('click', outside)
   root.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach(button => button.addEventListener('click', () => updateTravelState({ [button.dataset.clear!]: '' })))
   document.addEventListener('lumen:travel-filter', sync)
   retry.addEventListener('click', load)
   sync(); void load()
   onUnmount(root, () => { clearTimeout(timer); request.abort(); document.removeEventListener('lumen:travel-filter', sync); document.removeEventListener('click', outside) })
  })
 }
 initializeTravelSearch(); document.addEventListener('astro:page-load', initializeTravelSearch); document.addEventListener('lumen:content-mounted', initializeTravelSearch)
</script>
