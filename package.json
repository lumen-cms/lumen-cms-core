    "nprogress": "0.2.0",
    "postcss": "^8.5.32",
    "react-big-calendar": "1.20.0",
    "react-countdown": "2.3.6",
    "react-hook-form": "7.91.0",
    "react-hook-form-mui": "9.0.1",
    "react-inlinesvg": "4.5.0",
    "react-intersection-observer": "11.0.1",
    "react-player": "3.4.0",
    "react-rewards": "3.0.0",
    "react-scroll-parallax": "3.5.0",
    "react-spring": "10.0.4",
    "react-timeline-animation": "1.2.3",
    "react-use": "^17.6.1",
    "sitemap": "10.0.0",
    "storyblok-js-client": "7.8.1",
    "swiper": "14.3.0",
    "swr": "2.5.1",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "use-count-up": "3.0.1",
    "use-debounce": "10.1.1",
    "zustand": "5.0.16"
  },
  "peerDependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/fragment-matcher": "7.1.0",
    "@graphql-codegen/import-types-preset": "4.0.1",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-document-nodes": "6.1.1",
    "@graphql-codegen/typescript-graphql-files-modules": "4.0.1",
    "@graphql-codegen/typescript-graphql-request": "7.1.0",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@lumen/storyblok-material-icons": "git+https://github.com/dohomi/storyblok-fieldtype-material-icons-selector.git",
    "@next/bundle-analyzer": "16.4.3",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/nextjs": "10.6.4",
    "@storybook/react": "10.6.4",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@welldone-software/why-did-you-render": "10.0.1",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "chromatic": "18.13.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "happy-dom": "21.0.4",
    "install": "0.13.0",
    "local-ssl-proxy": "2.0.5",
    "next": "16.4.3",
    "prettier": "^2.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storyblok": "4.25.0",
    "storybook": "10.6.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "^5.99.0"
  },
  "packageManager": "yarn@3.2.4",
  "resolutions": {
    "@graphql-codegen/plugin-helpers/@graphql-tools/utils": "12.1.0",
    "@graphql-codegen/visitor-plugin-common/@graphql-tools/utils": "12.1.0",
    "@storyblok/richtext/happy-dom": "21.0.4",
    "@tiptap/html/happy-dom": "21.0.4"
  }
}
