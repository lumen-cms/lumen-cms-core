{
  "name": "lumen-cms-core",
  "version": "1.11.1",
  "description": "Core website components for the LumenCMS",
  "repository": "https://github.com/lumen-cms/lumen-cms-core",
  "main": "src/index.ts",
  "files": [
    "src",
    "config"
  ],
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "devs": "next dev --webpack --experimental-https -p 4430",
    "dev-safe": "next dev --webpack -p 3001 & local-ssl-proxy --source 3000 --target 3001",
    "devss": "node next-dev-ssl.js & next dev --webpack -p 3001",
    "build": "tsc --noEmit && next build --webpack",
    "build-test": "cross-env TEST=TRUE npm run build",
    "start": "next start",
    "builds": "rimraf .babelrc && rimraf .next && npm run build && next start",
    "analyze": "rimraf .babelrc && cross-env BUNDLE_ANALYZE=true npm run build",
    "gen-ts-schema": "node scripts/storyblok-schema.cjs generate",
    "fetch-storyblok-components": "node scripts/storyblok-schema.cjs pull",
    "push-storyblok-components": "node scripts/storyblok-schema.cjs push",
    "update-storyblok": "npm run fetch-storyblok-components && npm run gen-ts-schema && npm run codegen",
    "update-storyblok-1": "npm run fetch-storyblok-components && npm run gen-ts-schema",
    "codegen": "graphql-codegen --config codegen.yml",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 -c .storybook",
    "build-story": "storybook build -c .storybook -o public_storybook",
    "vercel-build": "storybook build -c .storybook -o public",
    "deploy-storybook": "rimraf public_storybook && npm run build-story && vercel --prod",
    "prepublishOnly": "npm run lint:fix && npm run check-types",
    "release": "np",
    "check-types": "tsc --noEmit",
    "lint": "yarn lint:code && yarn format:check",
    "lint:fix": "yarn lint:code --fix && yarn format:fix",
    "test": "vitest run --project unit",
    "codegen-let": "graphql-let",
    "init-chromatic": "yarn build-story && npx chromatic --project-token=60b756d637f7 --storybook-build-dir=./public_storybook --allow-console-errors",
    "chromatic": "npx chromatic --allow-console-errors --project-token 60b756d637f7",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "reference:site": "node scripts/reference-site.cjs",
    "test:visual": "chromatic --build-script-name build-story",
    "lint:code": "eslint './src/**/*.{ts,tsx}'",
    "format:check": "node scripts/check-format.cjs",
    "format:fix": "node scripts/check-format.cjs --write",
    "test:codegen": "node scripts/check-codegen.cjs",
    "audit:security": "node scripts/security-audit.cjs",
    "storyblok:types:candidate": "node scripts/storyblok-schema.cjs candidate",
    "check:storyblok-types": "node scripts/storyblok-schema.cjs check",
    "test:page-data": "node scripts/check-server-page-data.cjs"
  },
  "author": "Dominic Garms",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.29.0",
    "@charlietango/hooks": "2.3.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@floating-ui/dom": "1.8.0",
    "@mui/icons-material": "9.5.0",
    "@mui/lab": "9.0.0-beta.10",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@mui/system": "9.5.0",
    "@mui/utils": "9.5.0",
    "@mui/x-date-pickers": "9.16.0",
    "@storyblok/api-client": "0.9.1",
    "@storyblok/js": "6.4.0",
    "@storyblok/preview-bridge": "2.6.1",
    "@storyblok/react": "7.4.0",
    "@storyblok/richtext": "5.3.3",
    "@types/cors": "^2.8.19",
    "@types/diacritics": "^1.3.3",
    "@types/facebook-pixel": "^0.0.31",
    "@types/gtag.js": "^0.0.20",
    "@types/js-cookie": "^3.0.6",
    "@types/nprogress": "^0.2.3",
    "@types/react": "19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "clean-deep": "3.4.0",
    "cors": "2.8.6",
