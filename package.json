{
  "name": "lumen-cms-core",
  "version": "2.0.0",
  "description": "Core website components for the LumenCMS",
  "repository": "https://github.com/lumen-cms/lumen-cms-core",
  "main": "src/index.ts",
  "files": [
    "src",
    "config"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.cjs",
    "check:react-doctor": "npx --yes react-doctor@latest --yes --verbose --scope full --blocking warning",
    "dev": "next dev --experimental-https",
    "dev:bali": "dotenv -e .env.bali --no-expand -v NEXT_DIST_DIR=.next-reference/bali -- next dev --experimental-https -p 3009 --hostname 127.0.0.1",
    "dev:planet": "dotenv -e .env.planet --no-expand -v NEXT_DIST_DIR=.next-reference/planet -- next dev --experimental-https -p 3010 --hostname 127.0.0.1",
    "dev:upskill": "dotenv -e .env.upskill --no-expand -v NEXT_DIST_DIR=.next-reference/upskill -- next dev --experimental-https -p 3011 --hostname 127.0.0.1",
    "build": "pnpm run check-types && next build",
    "build:bali": "dotenv -e .env.bali --no-expand -v NEXT_DIST_DIR=.next-reference/bali -- pnpm run build",
    "build:planet": "dotenv -e .env.planet --no-expand -v NEXT_DIST_DIR=.next-reference/planet -- pnpm run build",
    "build:upskill": "dotenv -e .env.upskill --no-expand -v NEXT_DIST_DIR=.next-reference/upskill -- pnpm run build",
    "build-test": "cross-env TEST=TRUE pnpm run build",
    "start": "next start",
    "builds": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && pnpm run build && next start",
    "analyze": "next analyze",
    "gen-ts-schema": "storyblok --path ./src/typings/storyblok --no-log-file-enabled --no-report-enabled types generate --space 82895 --filename components --type-suffix Storyblok --custom-fields-parser ./generate-ts-schema-custom-types.js && node scripts/generate-storyblok-registry.cjs",
    "fetch-storyblok-components": "storyblok --path ./src/typings/storyblok --no-log-file-enabled --no-report-enabled components pull --space 82895",
    "push-storyblok-components": "storyblok --path ./src/typings/storyblok --no-log-file-enabled --no-report-enabled components push --space 82895 --from 82895",
    "update-storyblok": "pnpm run fetch-storyblok-components && pnpm run gen-ts-schema && pnpm run codegen",
    "update-storyblok-1": "pnpm run fetch-storyblok-components && pnpm run gen-ts-schema",
    "codegen": "graphql-codegen --config codegen.yml",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 -c .storybook",
    "build-story": "storybook build -c .storybook -o public_storybook",
    "vercel-build": "storybook build -c .storybook -o public",
    "deploy-storybook": "pnpm run build-story && pnpm dlx vercel --prod",
    "prepublishOnly": "pnpm run lint:fix && pnpm run check-types",
    "release": "np",
    "check-types": "node scripts/check-types.cjs",
    "lint": "pnpm lint:code && pnpm format:check",
    "lint:fix": "pnpm lint:code --fix && pnpm format:fix",
    "test": "vitest run --project unit",
    "codegen-let": "graphql-let",
    "init-chromatic": "pnpm build-story && npx chromatic --project-token=60b756d637f7 --storybook-build-dir=./public_storybook --allow-console-errors",
    "chromatic": "npx chromatic --allow-console-errors --project-token 60b756d637f7",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "reference:site": "node scripts/reference-site.cjs",
    "test:visual": "chromatic --build-script-name build-story",
    "lint:code": "oxlint src",
    "format:check": "oxfmt --check 'src/**/*.{ts,tsx}'",
    "format:fix": "oxfmt --write 'src/**/*.{ts,tsx}'",
    "test:codegen": "node scripts/check-codegen.cjs",
    "audit:security": "node scripts/security-audit.cjs",
    "audit:deps": "fallow dead-code --unused-deps",
    "check:storyblok-types": "pnpm gen-ts-schema && git diff --exit-code -- src/typings/storyblok/types && pnpm check-types",
    "test:page-data": "node scripts/check-server-page-data.cjs",
    "test:website": "node scripts/test-website.cjs",
    "test:website:bali": "node scripts/test-website.cjs bali",
    "test:website:planet": "node scripts/test-website.cjs planet",
    "test:website:upskill": "node scripts/test-website.cjs upskill",
    "test:website:install": "playwright install chromium",
    "test:website:runner": "node --test test/websites/*.test.cjs",
    "codegen:travel": "graphql-codegen --config codegen.travel.yml",
    "test:storyblok-registry": "node --test test/storyblok-registry-generation.test.cjs",
    "astro:site": "node scripts/astro-site.cjs",
    "astro:cms": "node scripts/astro-site.cjs --cms",
    "test:astro:bundles": "node scripts/check-astro-bundles.cjs",
    "test:astro:carousels": "node scripts/check-astro-carousels.cjs",
    "test:astro:tabs": "node scripts/check-astro-tabs.cjs",
    "astro:check": "pnpm --filter lumen-cms-astro check",
    "test:astro": "vitest run --project unit test/astro",
    "test:seo:parity": "vitest run --project unit test/astro/seo-parity.test.ts test/astro/seo.test.ts test/astro/sitemap-parity.test.ts test/astro/sitemap.test.ts test/astro/static-sitemap.test.ts",
    "test:seo:sites": "node scripts/check-seo-parity.cjs",
    "test:seo:corpus": "cross-env SEO_SITE_PARITY=1 vitest run --project unit test/astro/seo-parity.test.ts",
    "test:astro:error-pages:live": "node scripts/check-astro-live-error-pages.mjs",
    "test:astro:error-routing": "node scripts/check-astro-error-routing.mjs",
    "test:astro:dialog-focus": "node scripts/check-astro-dialog-focus.cjs",
    "test:astro:fixture": "node scripts/check-astro-fixture.cjs",
    "test:astro:ui-regressions": "node scripts/check-astro-ui-regressions.cjs",
    "test:astro:story-list": "node scripts/check-astro-story-list.cjs",
    "astro:registry": "node scripts/astro-registry-audit.cjs",
    "test:astro:a11y": "node scripts/check-astro-accessibility.cjs",
    "test:astro:a11y-fixture": "node scripts/check-astro-a11y-fixture.cjs",
    "astro:a11y-report": "node scripts/report-astro-accessibility-ownership.cjs",
    "test:astro:images": "node scripts/check-astro-images.cjs",
    "test:astro:image-priority": "node scripts/check-astro-image-priority.cjs",
    "test:astro:story-images": "node scripts/check-astro-story-images.cjs",
    "test:astro:packages": "node scripts/check-astro-packages.cjs && node scripts/check-astro-consumer-css.mjs && node scripts/check-astro-icons.mjs",
    "astro:sync-schemas": "node scripts/sync-astro-schemas.cjs",
    "test:astro:google-worker": "node scripts/check-astro-google-worker.mjs",
    "test:astro:google-deployment": "node scripts/check-astro-google-deployment.mjs",
    "test:astro:facebook-worker": "node scripts/check-astro-facebook-worker.mjs",
    "test:astro:facebook-audit": "node scripts/check-facebook-partytown.cjs"
  },
  "author": "Dominic Garms",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.29.0",
    "@bprogress/core": "1.3.4",
    "@charlietango/hooks": "2.3.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/lab": "9.0.0-beta.10",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@mui/system": "9.5.0",
    "@mui/types": "9.5.0",
    "@mui/utils": "9.5.0",
    "@mui/x-date-pickers": "9.16.0",
    "@storyblok/api-client": "0.9.1",
    "@storyblok/js": "6.4.0",
    "@storyblok/preview-bridge": "2.6.1",
    "@storyblok/react": "7.4.0",
    "@storyblok/richtext": "5.3.3",
    "@types/cors": "^2.8.19",
    "@types/diacritics": "^1.3.3",
    "@types/facebook-pixel": "^0.0.31",
    "@types/gtag.js": "^0.0.20",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "clean-deep": "3.4.0",
    "clsx": "2.1.1",
    "cors": "2.8.6",
    "cssnano-simple": "3.0.2",
    "date-fns": "4.4.0",
    "diacritics": "1.3.0",
    "feed": "6.0.0",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "graphql-tag": "2.12.7",
    "js-cookie": "^3.0.8",
    "locale-currency": "1.1.0",
    "marked": "18.1.2",
    "mdi-material-ui": "8.0.0",
    "next-seo": "7.3.0",
    "postcss": "^8.5.32",
    "react-big-calendar": "1.20.0",
    "react-countdown": "2.3.6",
    "react-hook-form": "7.91.0",
    "react-hook-form-mui": "9.0.1",
    "react-inlinesvg": "4.5.0",
    "react-intersection-observer": "11.0.1",
    "react-player": "3.4.0",
    "react-rewards": "3.0.0",
    "react-scroll-parallax": "3.5.0",
    "react-timeline-animation": "1.2.3",
    "react-use": "^17.6.1",
    "sanitize-html": "^2.18.1",
    "sitemap": "10.0.0",
    "storyblok-js-client": "7.8.1",
    "swiper": "14.3.0",
    "swr": "2.5.1",
    "tslib": "^2.8.1",
    "use-count-up": "3.0.1",
    "use-debounce": "10.1.1",
    "zustand": "5.0.16"
  },
  "peerDependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/fragment-matcher": "7.1.0",
    "@graphql-codegen/import-types-preset": "4.0.1",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-document-nodes": "6.1.1",
    "@graphql-codegen/typescript-graphql-files-modules": "4.0.1",
    "@graphql-codegen/typescript-graphql-request": "7.1.0",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@lumen/storyblok-material-icons": "git+https://github.com/dohomi/storyblok-fieldtype-material-icons-selector.git",
    "@next/eslint-plugin-next": "16.4.3",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/nextjs": "10.6.4",
    "@storybook/react": "10.6.4",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@welldone-software/why-did-you-render": "10.0.1",
    "axe-core": "^4.14.0",
    "chromatic": "18.13.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.1",
    "dotenv-cli": "11.0.0",
    "esbuild": "0.28.2",
    "fallow": "3.37.0",
    "happy-dom": "21.0.4",
    "next": "16.4.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "pnpm": "11.28.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "storyblok": "4.25.0",
    "storybook": "10.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "^5.99.0"
  },
  "packageManager": "pnpm@11.28.9"
}
